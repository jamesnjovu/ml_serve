# Compiled artifacts
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump

# Hex package tarball
ml_serve-*.tar

# Temporary files, for example, from tests
/tmp/

# Dialyzer PLT cache
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Editors / tooling
/.idea/
/.elixir_ls/
/.lexical/
.DS_Store

# The example app's lockfile. Scoped deliberately: a bare `mix.lock` here also matches the
# root lockfile, which is tracked on purpose — the CI matrix pins against it, and the canary
# row deletes it explicitly to test resolving without one.
/examples/*/mix.lock

# Test fixtures written into the configured :model_root
/priv/models/
/examples/inference_service/_build/
/examples/inference_service/deps/
